# Absolute paths visible to the host Docker daemon, not agent-container paths.
FAU_HOST_PATH=
INFRA_TOOLS_HOST_PATH=
TTYD_USER=admin
TTYD_PASSWORD=

# ---------------------------------------------------------------------------
# FAU application stack (compose.yaml). The variables above belong to the
# agent-box stack (docker-compose.yml); one .env serves both, and each Compose
# file ignores the other's variables.
#
# Local development values only. Nothing here is a production credential.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=postgres
FAU_MIGRATE_PASSWORD=fau_migrate
FAU_APP_PASSWORD=fau_app
FAU_REGISTER_PASSWORD=fau_register
DB_POOL_MAX_CONNECTIONS=10
LOG_LEVEL=info

# Host ports the stack publishes on 127.0.0.1. Raise any of these only if the
# default collides with something else already running on the host; see
# docs/app-foundation-operations.md.
FAU_DB_PORT=5433
FAU_APP_PORT=8000
FAU_MAIL_PORT=8025
