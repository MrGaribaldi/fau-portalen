# FAU-eid agent-image: agent-box + verktøykjeden FAU og /opt/infra-tools krever.
#
# Rebuild gjøres fra verten, i FAU-mappen der denne fila og docker-compose.yml ligger:
#   docker compose build agent
#   docker compose up -d agent
#
# docker-compose.yml peker agent-tjenesten hit med context "." (FAU-prosjektroten),
# fordi Favro-CLI-kilden i .agents/skills/favro/favro-cli bygges inn. .dockerignore
# holder .env og resten av prosjektet utenfor byggekonteksten.
#
# Verified in base image v1.4.2 on 8 September 2026, and therefore NOT reinstalled
# here: terraform 1.16.1 (infra-tools requires >= 1.15.0), docker compose v5.5.1,
# node 22.23.2, npm 10.9.8, python 3.13.5, kubectl 1.37.0, git 2.47.3, ssh, ttyd.
# Those numbers have NOT been re-verified against v1.6.0 - do that in the first
# session after the rebuild (see "After the rebuild" below). The base image lacks a
# C compiler/linker (no cc/gcc/make/pkg-config), which Rust builds need. Entrypoint
# /ep.sh and the Claude session machinery are kept unchanged.
#
# Base bumped v1.4.2 -> v1.6.0 on 23 September 2026 for two reasons:
#   1. Claude Code is installed unpinned in the base (`npm install -g
#      @anthropic-ai/claude-code`) and that layer is cached, so rebuilding FAU's
#      image alone never moves it. v1.6.0 was built 2026-09-22 17:13Z, after
#      2.1.280 was published at 15:44Z, so it carries 2.1.280 - the version this
#      rebuild was asked to deliver. The base tag is what pins Claude Code; bump it
#      again to move that version, or add an explicit npm layer here if FAU ever
#      needs a version the base does not carry.
#   2. v1.6.0 adds the ALLOW_GIT_WRITE guard rail (scripts/git-guard.js) and the gh
#      CLI, replacing v1.4.2's blanket "do not run git operations" rule. See
#      docker-compose.yml and .claude/settings.json for how FAU sets that.
#
# Registry index digest for v1.6.0, read from GHCR 23 September 2026:
#   sha256:767ecb2af87803c59584d6562c6f17f6c0d8dacdf677d5df9a0a8d67b68fa24b
#   (built from agent-box revision c6b403bcffb43d640b6ddb16a8646345dc835039)
# The tag is kept in FROM so the build also works when the host pulls the image
# fresh from GHCR; the digest stands here as a checkpoint.
#
# After the rebuild, verify in a new session:
#   claude --version          # expect 2.1.280 or newer
#   favro --version           # expect favro-cli 0.2.2
#   terraform version && kubectl version --client && node --version
FROM ghcr.io/akantodevs/agent-box:v1.6.0

# Basisimaget har ingen USER (kjører /ep.sh som root, som dropper til claude).
USER root

# ---------------------------------------------------------------------------
# Systempakker
# ---------------------------------------------------------------------------
# gcc, libc6-dev, make, pkg-config
#   C-kompilator og linker for Rust-bygg. Favro-CLI-ens avhengighetskjede
#   (rustls 0.23 -> ring 0.17 via cc 1.2) kompilerer C, og basisimaget har
#   ingen cc i det hele tatt. Trengs også for FAU-backend i Rust senere.
# wireguard-tools, iptables, openresolv
#   Prerequisite i infra-tools/readme.md, brukt fra steg 1 for å nå clusteret
#   over privatnett. Pakkene i imaget gir i seg selv INGEN nettverkstilgang:
#   NET_ADMIN og /dev/net/tun er bevisst ikke gitt i docker-compose.yml. VPN-
#   ruting fra agentmiljøet er en egen beslutning før steg 1 (pre-0-guide S12)
#   og er ikke nødvendig for steg 0. De ligger her nå bare for å unngå en ny
#   verts-rebuild når steg 1 skal forberedes.
# age
#   Manuell inspeksjon/dekryptering av age-nøkkelen steg 0 lager. Steg 0 selv
#   trenger den ikke: nøkkelen genereres av terraform-provideren
#   clementblaise/age, ikke av et CLI (shared-modules/sops/main.tf).
# postgresql-client
#   psql mot den senere db-tjenesten i denne compose-stacken.
# sudo
#   Kun for å reise WireGuard-tunnelen. cap_add: NET_ADMIN i docker-compose.yml
#   fyller containerens bounding set, som bare root-prosesser arver; sesjonen
#   kjører som claude (uid 1000). Uten en smal sudo-regel er wg-quick ubrukelig
#   selv med NET_ADMIN. Regelen under gir claude NOPASSWD på wg-quick, wg og ip
#   og ingenting annet. Containeren bind-mounter allerede Docker-socketen, som
#   basis-entrypointen selv kaller root-ekvivalent på verten, så dette er en
#   marginal utvidelse.
RUN DEBIAN_FRONTEND=noninteractive apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      gcc \
      libc6-dev \
      make \
      pkg-config \
      wireguard-tools \
      iptables \
      openresolv \
      age \
      postgresql-client \
      sudo \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# SOPS
# ---------------------------------------------------------------------------
# Versjonen infra-tools/readme.md pinner for gitops-secrets (day-2-drift, ikke
# steg 0). Ikke i Debian trixie, så det pinnede release-binæret hentes og
# sjekksummeres mot getsops sin publiserte checksums-fil.
ARG SOPS_VERSION=3.11.0
ARG SOPS_SHA256=775f1384d55decfad228e7196a3f683791914f92a473f78fc47700531c29dfef
RUN curl -fsSL -o /tmp/sops \
      "https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}/sops-v${SOPS_VERSION}.linux.amd64" \
 && echo "${SOPS_SHA256}  /tmp/sops" | sha256sum -c - \
 && install -m 0755 /tmp/sops /usr/local/bin/sops \
 && rm -f /tmp/sops \
 && sops --version --disable-version-check

# ---------------------------------------------------------------------------
# WireGuard: smal sudo-regel
# ---------------------------------------------------------------------------
# Trengs fra steg 1 for å nå clusteret over privatnett: kubeconfig.yaml peker på
# https://10.0.1.250:6443, og klientkonfigurasjonen ligger i runtime-volumet som
# .config/fau.conf.
#
# Bare to kommandoer, ingen wildcard-shell. ip og resolvconf trenger IKKE egne
# regler: wg-quick kjører selv som root under sudo, så alt det kaller internt er
# allerede root. Verifiserte stier i imaget: /usr/bin/wg-quick og /usr/bin/wg.
RUN printf '%s\n' \
      'claude ALL=(root) NOPASSWD: /usr/bin/wg-quick, /usr/bin/wg' \
      > /etc/sudoers.d/50-wireguard \
 && chmod 0440 /etc/sudoers.d/50-wireguard \
 && visudo -c -f /etc/sudoers.d/50-wireguard

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
# Favro-CLI krever Rust >= 1.82 (favro-cli/Cargo.toml), og FAU-backend skal
# skrives i Rust. Toolchainen legges systemvidt, ikke i /home/claude, fordi
# hjemmemappa bare er vedvarende for .claude og .codex.
ARG RUST_VERSION=1.98.1
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_INIT_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL -o /tmp/rustup-init \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
 && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum -c - \
 && chmod 0755 /tmp/rustup-init \
 && /tmp/rustup-init -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_VERSION}" \
      --component clippy --component rustfmt \
 && rm -f /tmp/rustup-init \
 && chmod -R a+w "${RUSTUP_HOME}" "${CARGO_HOME}" \
 && rustc --version \
 && cargo --version

# Sesjonsterminalen er et login-shell og setter PATH fra Debian-standarden, ikke
# fra imagets ENV. Uten denne profilfila er cargo/rustc usynlig i sesjonene.
RUN printf '%s\n' \
      'export RUSTUP_HOME=/usr/local/rustup' \
      'export CARGO_HOME=/usr/local/cargo' \
      'case ":$PATH:" in' \
      '  *":/usr/local/cargo/bin:"*) ;;' \
      '  *) PATH="/usr/local/cargo/bin:$PATH"; export PATH ;;' \
      'esac' \
      > /etc/profile.d/rust.sh \
 && chmod 0644 /etc/profile.d/rust.sh

# ---------------------------------------------------------------------------
# Favro-CLI
# ---------------------------------------------------------------------------
# Bygges inn i /usr/local/bin, som ligger på PATH i både login-shell og
# `docker compose exec`. Da er `favro` tilgjengelig med én gang og også etter at
# containeren gjenopprettes; ~/.cargo/bin ville forsvunnet ved recreate.
# --locked uses the Cargo.lock that ships in the skill. Vendored source is
# favro-cli 0.2.2 at upstream commit 4beaee2 (see .agents/skills/favro/UPSTREAM.md);
# it adds `attach --replace` and `detach`. If the CLI source changes without a new
# host rebuild, the agent can build locally:
#   cargo install --path /workspace/.agents/skills/favro/favro-cli \
#     --locked --root "$HOME/.local"
# og legge $HOME/.local/bin først på PATH.
COPY .agents/skills/favro/favro-cli /usr/local/src/favro-cli
RUN cargo install --path /usr/local/src/favro-cli --locked --root /usr/local \
 && rm -rf /usr/local/src/favro-cli "${CARGO_HOME}/registry" "${CARGO_HOME}/git" \
 && favro --version

# Credentials hører ikke hjemme i imaget eller i Compose: Favro-CLI leser
# /infra-runtime/infrastructure/favro.env via .favro/project.toml, og Terraform
# leser .credentials.tfvars fra samme private volum.
